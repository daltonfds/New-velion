# NewVelion remote MCP — Supabase OAuth 2.1
# The MCP endpoint uses Supabase Auth as the OAuth authorization server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# @supabase/server can also use these server-side aliases.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS=
SUPABASE_SECRET_KEY=

# Existing NewVelion service credentials used by the operational MCP tools.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: UUID of the NewVelion admin account used as audit actor for MCP writes.
NEWVELION_MCP_ACTOR_ID=
